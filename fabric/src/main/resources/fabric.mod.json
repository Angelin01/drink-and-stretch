{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "icon": "${iconLogo}",
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.angelin01.drinkandstretch.fabric.DrinkAndStretchFabric"
    ],
    "modmenu": [
      "com.angelin01.drinkandstretch.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "drinkandstretch.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "minecraft": "~${minecraftVersion}",
    "java": ">=${javaVersion}",
    "fabric-api": "*",
    "cloth-config": "^${clothConfigVersion}.0.0"
  }
}
